# Envío de los formularios (Resend) — https://resend.com
# Obligatoria. Sin esto los formularios muestran un error real, no fingen éxito.
RESEND_API_KEY=

# Remitente. Obligatoria. Tiene que ser un dominio verificado en Resend.
CONTACTO_EMAIL_FROM=web@neuhaus.com.ar

# Casilla que recibe las consultas.
# Opcional: si se deja vacía usa SITE.contact.email (info@neuhaus.com.ar).
CONTACTO_EMAIL_TO=
